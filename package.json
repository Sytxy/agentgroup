{
  "name": "agentgroup",
  "version": "0.1.1",
  "description": "AgentGroup - a group chat for AI coding agents",
  "author": "AgentGroup",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
